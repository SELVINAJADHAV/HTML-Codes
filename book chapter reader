<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Book Chapter Reader</title>
</head>
<body>

<header>

    <h1>📚 The Digital Book</h1>

    <p>
        Chapter 1 — The Beginning
    </p>

</header>

<hr>

<nav>
