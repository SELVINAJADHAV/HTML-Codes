<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Coding Profile</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            background: #edf7f8;
            padding: 30px;
        }

        .profile {
            max-width: 700px;
            margin: auto;
            background: white;
            padding: 35px;
            border-radius: 20px;
            text-align: center;
        }

        h1 {
            color: #147b83;
        }

        .intro {
            line-height: 1.7;
            color: #555;
        }

        .skills {
            margin-top: 25px;
        }

        .skill {
            display: inline-block;
            padding: 10px 16px;
            margin: 6px;
            background: #e0f3f4;
            border-radius: 20px;
            color: #147b83;
            font-weight: bold;
        }

        .section {
            margin-top: 25px;
            padding: 18px;
            background: #f4fbfb;
            border-radius: 12px;
        }
    </style>
</head>

<body>

<div class="profile">

    <h1>👩‍💻 Student Coding Profile</h1>

    <p class="intro">
        Hello! I am a Computer Science student learning programming,
        web development and problem solving.
    </p>

    <div class="section">
        <h2>🎓 Education</h2>
        <p>Bachelor's Degree in Computer Science</p>
    </div>

    <div class="section">
        <h2>💻 Skills</h2>

        <div class="skills">
            <span class="skill">HTML</span>
            <span class="skill">CSS</span>
            <span class="skill">C</span>
            <span class="skill">SQL</span>
            <span class="skill">Python</span>
        </div>
    </div>

    <div class="section">
        <h2>🎯 Current Goal</h2>
        <p>
            Build practical projects and improve my programming skills
            through regular practice.
        </p>
    </div>

</div>

</body>
</html>
