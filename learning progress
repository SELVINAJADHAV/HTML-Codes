<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Learning Progress</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            background: #f4f4f4;
            padding: 20px;
        }

        .container {
            max-width: 850px;
            margin: auto;
            background: white;
            padding: 30px;
            border-radius: 15px;
        }

        h1 {
            text-align: center;
        }

        .subject {
            margin: 25px 0;
        }

        .bar {
            width: 100%;
            height: 25px;
            background: #ddd;
            border-radius: 20px;
            overflow: hidden;
        }

        .progress {
            height: 100%;
            text-align: right;
            padding-right: 8px;
            box-sizing: border-box;
        }

        .html {
            width: 80%;
            background: #bbb;
        }

        .c {
            width: 65%;
            background: #aaa;
        }

        .math {
            width: 55%;
            background: #999;
        }

        .database {
            width: 70%;
            background: #888;
        }

        .python {
            width: 45%;
            background: #777;
        }
    </style>
</head>

<body>

<div class="container">

    <h1>📈 My Learning Progress</h1>

    <p>
        This page shows my progress in different learning areas.
    </p>

    <div class="subject">
        <h3>HTML — 80%</h3>
        <div class="bar">
            <div class="progress html">80%</div>
        </div>
    </div>

    <div class="subject">
        <h3>C Programming — 65%</h3>
        <div class="bar">
            <div class="progress c">65%</div>
        </div>
    </div>

    <div class="subject">
        <h3>Mathematics — 55%</h3>
        <div class="bar">
            <div class="progress math">55%</div>
        </div>
    </div>

    <div class="subject">
        <h3>Database — 70%</h3>
        <div class="bar">
            <div class="progress database">70%</div>
        </div>
    </div>

    <div class="subject">
        <h3>Python — 45%</h3>
        <div class="bar">
            <div class="progress python">45%</div>
        </div>
    </div>

</div>

</body>
</html>
